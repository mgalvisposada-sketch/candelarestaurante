# Copiar a .env — NUNCA subir secretos reales al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Solo server-side. No usar en el browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Contraseña de la base (Settings → Database). Solo para scripts de migración local.
SUPABASE_DB_PASSWORD=your_database_password

# Asistente Candela (OpenAI Responses API). Solo server-side.
OPENAI_API_KEY=sk-...
# Opcional; por defecto gpt-6-luna
# OPENAI_AGENT_MODEL=gpt-6-luna
